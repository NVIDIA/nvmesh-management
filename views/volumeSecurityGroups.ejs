<h1>Volume Security Groups</h1>
<hr />

<div class="angular-bootstrap multi-select-pager" ng-controller="volumeSecurityGroupsController as VSGCtrl">
	<!-- Edit/Create Modal -->
	<div class="modal fade" id="editVSGModal" role="dialog" data-backdrop="static">
		<div class="modal-dialog large-modal">
			<div class="modal-content">
				<div class="modal-header">
					<button type="button" class="close" data-dismiss="modal" ng-click="VSGCtrl.cancelEdit()">&times;</button>
					<h3 class="modal-title text-center">Volume Security Group</h3>
				</div>
				<div class="modal-body">
					<ng-form name="editVSGForm">
						<div ng-class="{'has-error': editVSGForm.name.$error.required || VSGCtrl.invalidName(VSGCtrl.VSG._id, editVSGForm) }" class="form-group">
							<label class="control-label">Name</label>
							<div class="inner-addon right-addon">
								<i class="ion ion-alert-circled" ng-show="editVSGForm.name.$error.required"></i>
								<input name="name" id="name" bootstrap-modal-autofocus="#editVSGModal" ng-disabled="VSGCtrl.editMode" class="form-control" type="text" autofocus value="{{ VSGCtrl.VSG._id }}" ng-model="VSGCtrl.VSG._id" placeholder="Enter Name.." required>
							</div>
						</div>
						<div class="form-group">
							<label class="control-label">Description</label>
							<input name="description" maxlength="1024" class="form-control" type="text" value="{{ VSGCtrl.VSG.description }}" ng-model="VSGCtrl.VSG.description" placeholder="Enter Description..">
						</div>
						<multi-select-keys reload-data="VSGCtrl.reloadKeysList" selected="VSGCtrl.selectedKeys" />
					</ng-form>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-primary mgmt-btn-primary" ng-disabled="editVSGForm.$invalid" ng-click="VSGCtrl.addVSG()">{{ VSGCtrl.editMode ? "Update" : "Add" }}</button>
					<button type="button" class="btn btn-default" data-dismiss="modal" ng-click="VSGCtrl.cancelEdit()">Cancel</button>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-md-12">
			<div class="alert alert-danger fade in alert-losing-changes" ng-if="VSGCtrl.isDirty && !VSGCtrl.pendingMultiSelectAction">
				<i class="ion ion-alert-circled"></i>
				<a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
				<strong>Action needed!</strong> Your {{ VSGCtrl.getNumberOfChanges() }} changes aren’t final until you save them.
				<span class="pull-right">
					<i class="fa fa-floppy-o"></i>
					<a id="saveChangesAnchor" tabindex="0"  class="alert-losing-changes-btn" href='#' ng-click="VSGCtrl.save()">Save Changes</a>
					<i class="fa fa-trash-o"></i>
					<a class="alert-losing-changes-btn" href='#' ng-click="VSGCtrl.cancel()">Discard Changes</a>
				</span>
			</div>
			<div class="pull-right" ng-hide="VSGCtrl.isDirty">
				<paging-summary
					last-item-index="VSGCtrl.lastItemIndex"
					current-page="VSGCtrl.currentPage"
					count="VSGCtrl.count"
					total="VSGCtrl.totalVSGs">
				</paging-summary>
				<ul id="VSGsPagination" class="pagination">
				</ul>
				<select-columns entity-name="VSGs"/>
			</div>

			<table id="VSGs-table" multi-select actions="VSGCtrl.actions" is-checked="VSGCtrl.isAllSelected" is-dirty="VSGCtrl.isDirty"
			pending-action="VSGCtrl.pendingMultiSelectAction" selected="VSGCtrl.selected" total-items="VSGCtrl.totalVSGs" ng-init="VSGCtrl.selected={}"
 			class="table table-striped table-hover table-filtSort">
				<thead>
					<tr sortable-row="VSGs">
						<th column-name="Name" draggable="true" class="fixed-size-column md-column" data-sortable data-filterable data-field="_id" data-placeholder="Search by name">Name</th>
						<th column-name="Description" draggable="true" data-sortable data-filterable data-field="description" data-placeholder="Search by description">Description</th>
						<th column-name="Modified By" draggable="true" class="fixed-size-column md-column" data-sortable data-filterable data-field="modifiedBy" data-placeholder="Search by last modifier">Modified By</th>
						<th column-name="Date Modified" draggable="true" class="fixed-size-column md-column" data-sortable data-filterable data-type="dateRange" data-field="dateModified">Date Modified</th>
						<th column-name="Edit" class="fixed-size-column sx-column"></th>
					</tr>
				</thead>
				<tbody>
					<tr sortable-row="VSGs" selectable id="row-{{$index}}" model="VSG" key="VSG._id" ng-repeat="VSG in VSGCtrl.VSGs">
						<td column-name="Name" >{{ VSG._id }}</td>
						<td column-name="Description" title="{{ VSG.description }}">{{ VSG.description | ellipsis }}</td>
						<td column-name="Modified By">{{ VSG.modifiedBy }}</td>
						<td column-name="Date Modified">{{ VSG.dateModified | date:"MM/dd/yyyy 'at' h:mma"}}</td>
						<td column-name="Edit" class="fixed-size-column sx-column">
							<a class="fa fa-pencil edit-button" single-item-action ng-click="VSGCtrl.editVSG($index)"
							ng-class data-toggle="modal" data-target="#editVSGModal">
							</a>
						</td>
					</tr>
				</tbody>
			</table>

			<div class="fab" data-toggle="modal" data-target="#editVSGModal" ng-click="VSGCtrl.newVSG()">
				<i class="fa fa-plus"></i>
			</div>
		</div>
	</div>
</div>