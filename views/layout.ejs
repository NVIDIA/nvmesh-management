		<script src="/javascripts/jquery-2.1.4.min.js"></script>
		<script src="/javascripts/jquery-ui.min.js"></script>
		<script src="/javascripts/bootstrap.min.js"></script>
		<script src="/javascripts/angular.js"></script>
		<script src="/javascripts/angular.ui.bootstrap.js"></script>
		<script src="/javascripts/angular-cookies.min.js"></script>
		<script src="/javascripts/react.development.js"></script>
		<script src="/javascripts/react-dom.development.js"></script>
		<script src="/javascripts/react-hook-form.js"></script>
		<script src="/javascripts/selectize.min.js"></script>
		<script type="text/javascript" src="/javascripts/tree-grid-directive.js"></script>
		<script type="text/javascript" src="/javascripts/pjax.js"></script>
		<script type="text/javascript" src="/javascripts/jquery.twbsPagination.min.js"></script>
		<script type="text/javascript" src="/javascripts/jquery.easing.1.3.js"></script>
		<script type="text/javascript" src="/javascripts/js.cookie.js"></script>
		<script type="text/javascript" src="/javascripts/d3.js"></script>
		<script type="text/javascript" src="/javascripts/c3.js"></script>
		<script type="text/javascript" src="/javascripts/socket.io-4.5.4.js"></script>
		<script type="text/javascript" src="/javascripts/site.js"></script>
		<script type="text/javascript" src="/javascripts/angular-progress-arc.min.js"></script>

		<script type="text/javascript" src="/javascripts/consts.js"></script>
		<script type="text/javascript" src="/javascripts/profileScheme.js"></script>
		<script type="text/javascript" src="/javascripts/controllers/managementController.js"></script>
		<script type="module" src="/javascripts/controllers/reactController.js"></script>
		<script type="text/javascript" src="/javascripts/controllers/serverController.js"></script>
		<script type="text/javascript" src="/javascripts/controllers/volumesController.js"></script>
		<script type="text/javascript" src="/javascripts/controllers/volumeSecurityGroupsController.js"></script>
		<script type="text/javascript" src="/javascripts/clientConsts.js"></script>
		<script type="text/javascript" src="/javascripts/moment-with-locales.js"></script>
		<script type="text/javascript" src="/javascripts/daterangepicker.js"></script>

		<!-- Services -->
		<script type="text/javascript" src="/javascripts/services/confirmationsService.js"></script>
		<script type="text/javascript" src="/javascripts/services/alertService.js"></script>
		<script type="text/javascript" src="/javascripts/services/diskService.js"></script>
		<script type="text/javascript" src="/javascripts/services/utilsService.js"></script>
		<script type="text/javascript" src="/javascripts/services/paginationService.js"></script>
		<script type="text/javascript" src="/javascripts/services/multiSelectService.js "></script>
		<script type="text/javascript" src="/javascripts/services/nextPageService.js"></script>
		<script type="text/javascript" src="/javascripts/services/navigationService.js"></script>
		<script type="text/javascript" src="/javascripts/services/keysPressedService.js"></script>
		<script type="text/javascript" src="/javascripts/services/modalElementFocusService.js"></script>

		<!-- Directives -->
		<script type="text/javascript" src="/javascripts/directives/ngRepeatFinished.js"></script>
		<script type="text/javascript" src="/javascripts/directives/alerts.js"></script>
		<script type="text/javascript" src="/javascripts/directives/statusGauge.js"></script>
		<script type="text/javascript" src="/javascripts/directives/diskDisplay.js"></script>
		<script type="text/javascript" src="/javascripts/directives/nicDisplay.js"></script>
		<script type="text/javascript" src="/javascripts/directives/textOrEmailValidator.js"></script>
		<script type="text/javascript" src="/javascripts/directives/bootstrapModalAutofocus.js"></script>
		<script type="text/javascript" src="/javascripts/directives/toggle.js"></script>
		<script type="text/javascript" src="/javascripts/directives/multiSelectTable.js"></script>
		<script type="text/javascript" src="/javascripts/directives/multiSelectBalloon.js"></script>
		<script type="text/javascript" src="/javascripts/directives/isIndeterminate.js"></script>
		<script type="text/javascript" src="/javascripts/directives/angular-selectize.js"></script>
		<script type="text/javascript" src="/javascripts/directives/singleItemAction.js"></script>
		<script type="text/javascript" src="/javascripts/directives/allocationChart.js"></script>
		<script type="text/javascript" src="/javascripts/directives/diskSegmentToolTip.js"></script>
		<script type="text/javascript" src="/javascripts/directives/sortableRow.js"></script>
		<script type="text/javascript" src="/javascripts/directives/selectTableColumns.js"></script>
		<script type="text/javascript" src="/javascripts/directives/domainSelector.js"></script>
		<script type="text/javascript" src="/javascripts/directives/durationPicker.js"></script>
		<script type="text/javascript" src="/javascripts/directives/volumeRaidOptions.js"></script>
		<script type="text/javascript" src="/javascripts/directives/volumeSpaceAllocationBar.js"></script>
		<script type="text/javascript" src="/javascripts/directives/volumeClassLimiters.js"></script>
		<script type="text/javascript" src="/javascripts/directives/volumeTargetAndDriveLimiters.js"></script>
		<script type="text/javascript" src="/javascripts/directives/volumeLimiters.js"></script>
		<script type="text/javascript" src="/javascripts/directives/volumeDiagramLayout.js"></script>
		<script type="text/javascript" src="/javascripts/directives/volumeDiagramTargetsView.js"></script>
		<script type="text/javascript" src="/javascripts/directives/volumeDiagram.js"></script>
		<script type="text/javascript" src="/javascripts/directives/pagingSummary.js"></script>
