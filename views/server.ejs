<div class="angular-bootstrap" ng-controller="serverController as serverCtrl" ng-init='serverCtrl.init("<%- server ? server.node_id : "" %>")'>
	<div class="row">
		<div class="col-lg-6 col-md-6 col-sx-12">
			<h1>Target <span class="small">{{ serverCtrl.server.node_id }}</span></h1>
		</div>
		<div class="text-right col-lg-6 col-md-6 col-sx-12">
			<h1 title="{{ (serverCtrl.server.dateModified | pingToStatus: serverCtrl.server.tomaStatus).msg }}">
				<span ng-class="(serverCtrl.server.dateModified | pingToStatus: serverCtrl.server.tomaStatus).class"></span>
			 	Last ping <span class="small">{{ serverCtrl.server.dateModified | date:"MM/dd/yyyy 'at' h:mma" }}</span>
			 </h1>
		</div>
	</div>
	<hr />
	<div class="row server-gauges-row">
		<div class="col-lg-6 col-sx-12 col-md-6">
			<statusGauge graph-id="graph4" header="Drives" icon-class="fa fa-hdd-o"
				linked-gauge="{{ true }}"
				main-link='/disks?filter={"node_id": "{{serverCtrl.server.node_id}}"}'
				first-element-name="Healthy"
				first-element-value="serverCtrl.counters.diskCount.total - (serverCtrl.counters.diskCount.alarm + serverCtrl.counters.diskCount.critical)"
				first-element-link='/disks?filter={"node_id": "{{serverCtrl.server.node_id}}", "disks.health": "healthy"}'
				second-element-name="Critical"
				second-element-value="serverCtrl.counters.diskCount.critical"
				second-element-link='/disks?filter={"node_id": "{{serverCtrl.server.node_id}}", "disks.health": "critical"}'
				third-element-name="Alarm"
				third-element-value="serverCtrl.counters.diskCount.alarm"
				third-element-link='/disks?filter={"node_id": "{{serverCtrl.server.node_id}}", "disks.health": "alarm"}'>
			</statusGauge>
		</div>
		<div class="col-lg-6 col-sx-12 col-md-6">
			<statusGauge header="NICs" icon-class="fa fa-signal"
				linked-gauge="{{ false }}"
				first-element-name="Healthy"
				first-element-value="serverCtrl.counters.nicsCount.total - (serverCtrl.counters.nicsCount.alarm + serverCtrl.counters.nicsCount.critical)"
				second-element-name="Critical"
				second-element-value="serverCtrl.counters.nicsCount.critical"
				third-element-name="Alarm"
				third-element-value="serverCtrl.counters.nicsCount.alarm">
			</statusGauge>
		</div>
	</div>
	<div class="row">
		<div class="col-md-12">
			<h1>Drive Pools</h1>
			<hr />

			<div class="server-disks-container">
				<h4 style="display: inline-block">Parity Ready ({{ serverCtrl.ecOptimizedDisks.length }}) <span class="small diskCollpase" role="button" href="#ecOptimizedSection" aria-controls="ecOptimizedSection" data-toggle="collapse" style="cursor: pointer">hide</span></h4>
				<hr />

				<div class="row collapse in" id="ecOptimizedSection">
					<div ng-repeat="index in serverCtrl.ecOptimizedDisks track by $index">
						<div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-sx-12" ng-repeat="disk in serverCtrl.createComponentRow($index, serverCtrl.ecOptimizedDisks)">
							<diskDisplay server="serverCtrl.server" disk="disk">
							</diskDisplay>
						</div>
					</div>
				</div>

				<h4 style="display: inline-block">Concatenated, Striped and/or Mirrored ({{ serverCtrl.raidOptimizedDisks.length }}) <span class="small diskCollpase" role="button" href="#raidOptimizedSection" aria-controls="raidOptimizedSection" data-toggle="collapse" style="cursor: pointer">hide</span></h4>
				<hr />

				<div class="row collapse in" id="raidOptimizedSection">
					<div ng-repeat="index in serverCtrl.raidOptimizedDisks track by $index">
						<div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-sx-12" ng-repeat="disk in serverCtrl.createComponentRow($index, serverCtrl.raidOptimizedDisks)">
							<diskDisplay server="serverCtrl.server" disk="disk">
							</diskDisplay>
						</div>
					</div>
				</div>

				<h4 style="display: inline-block">Not formatted for NVMesh ({{ serverCtrl.notInitializedDisks.length }}) <span class="small diskCollpase" role="button" href="#notInitializedSection" aria-controls="notInitializedSection" data-toggle="collapse" style="cursor: pointer">hide</span></h4>
				<hr />

				<div class="row collapse in" id="notInitializedSection">
					<div ng-repeat="index in serverCtrl.notInitializedDisks track by $index">
						<div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-sx-12" ng-repeat="disk in serverCtrl.createComponentRow($index, serverCtrl.notInitializedDisks)">
							<diskDisplay server="serverCtrl.server" disk="disk">
							</diskDisplay>
						</div>
					</div>
				</div>

				<h4 style="display: inline-block">Excluded ({{ serverCtrl.excludedDisks.length }}) <span class="small diskCollpase" role="button" href="#excludedSection" aria-controls="excludedSection" data-toggle="collapse" style="cursor: pointer">hide</span></h4>
				<hr />

				<div class="row collapse in" id="excludedSection">
					<div ng-repeat="index in serverCtrl.excludedDisks track by $index">
						<div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-sx-12" ng-repeat="disk in serverCtrl.createComponentRow($index, serverCtrl.excludedDisks)">
							<diskDisplay server="serverCtrl.server" disk="disk">
							</diskDisplay>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-md-12">
				<h1>NICs</h1>
				<hr />
				<div class="row" ng-repeat="index in serverCtrl.generateRows(serverCtrl.server.nics.length) track by $index">
					<div class="col-xl-3 col-lg-6 col-md-6 col-sx-12" ng-repeat="nic in serverCtrl.createComponentRow($index, serverCtrl.server.nics) track by $index">
						<nicDisplay class="nic" nic="nic" user="user">
						</nicDisplay>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
